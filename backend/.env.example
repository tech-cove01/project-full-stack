# Copy values into the process environment; the Go server does not read .env files.
GO_ENV=development
API_ADDR=127.0.0.1:8082
# Deadline window for new orders; changes never recalculate existing snapshots.
GO_ORDER_PAY_TIMEOUT=15m
# Independent consumers of the same order Stream/group; valid range 1..8.
# Default 1 preserves serial consumption. Capacity comparisons set 4 explicitly.
ORDER_STREAM_WORKERS=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_DATABASE=project_full_stack_go
MYSQL_USER=fullstack
MYSQL_PASSWORD=fullstack_go_dev_only
# Open connections: 1..128, default 20. Idle defaults to the configured open limit.
GO_MYSQL_MAX_OPEN_CONNS=20
# Optional idle override: 0..Open; 0 disables idle retention. Unset to follow Open.
# GO_MYSQL_MAX_IDLE_CONNS=20
# 64/64 is an unmeasured capacity profile, not a throughput guarantee.
# Explicit client value binding; strict true/false, default false.
# utf8mb4/single statements remain fixed. SQL NULL uses nil/[]byte(nil);
# typed json.RawMessage(nil) has a different driver behavior. No QPS gain claimed.
GO_MYSQL_INTERPOLATE_PARAMS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DATABASE=0
REDIS_PASSWORD=
# Empty brokers disable community relay and all Kafka projection consumers.
KAFKA_BROKERS=
KAFKA_TOPIC=community.events
# Export explicitly; Go does not load this file. Concurrency1..8, batch1..64.
# Default batch1 retains original single-event transport. Opt-in batch>1 uses
# lane-owned synchronous Writers, conservative256KiB prefix/original1MiB limit,
# original SQL30s lease/attempt8/RequireAll; candidate32 has no measured QPS claim.
GO_COMMUNITY_RELAY_WORKERS=1
GO_COMMUNITY_RELAY_BATCH=1
# Optional AI. No .env file is read by the Go process; export these explicitly.
# Disabled/missing/invalid AI settings leave login and trading available.
AI_ENABLED=false
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_TOP_K=5
AI_MIN_SCORE=0.18
AI_MAX_OUTPUT_TOKENS=600
# Outer Chat HTTP request budget remains 45s; knowledge endpoints use 10s.
AI_CHAT_TIMEOUT_SECONDS=60
# Set true for supported Dashscope Qwen thinking models in buffered Chat mode.
AI_DISABLE_THINKING=false
# Optional public note search. Export explicitly; the API does not read .env.
# Empty or invalid ES configuration disables search, leaving core routes available.
ES_URL=
ES_INDEX=community-notes-v1
ES_TIMEOUT_SECONDS=3
# Compose only: docker compose -f compose.go.yaml --profile search up -d elasticsearch
GO_ES_PORT=9202
