# Local development only; replace these values for any shared deployment.
MYSQL_DATABASE=project_full_stack
MYSQL_USER=fullstack
MYSQL_PASSWORD=fullstack_dev_only
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_PORT=3306
REDIS_PORT=6379

# AI is disabled by default. Use AI_PROVIDER=stub for deterministic local tests.
AI_ENABLED=false
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_TOP_K=5
AI_MIN_SCORE=0.18
AI_MAX_OUTPUT_TOKENS=600
AI_CHAT_TIMEOUT_SECONDS=60
