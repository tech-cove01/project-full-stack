{
  "name": "project-full-stack-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "element-plus": "^2.14.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
