# Local development only; replace these values for any shared deployment.
MYSQL_DATABASE=project_full_stack
MYSQL_USER=fullstack
MYSQL_PASSWORD=fullstack_dev_only
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_PORT=3306
REDIS_PORT=6379

# Go process configuration; export explicitly (Go does not load this file).
# MySQL open limit: 1..128, default 20. Idle defaults to the configured open limit.
GO_MYSQL_MAX_OPEN_CONNS=20
# Optional idle override: 0..Open; 0 disables idle retention. Unset to follow Open.
# GO_MYSQL_MAX_IDLE_CONNS=20
# 64/64 is an unmeasured capacity profile, not a throughput guarantee.

# AI is disabled by default. Use AI_PROVIDER=stub for deterministic local tests.
AI_ENABLED=false
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_CHAT_MODEL=qwen-plus
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1024
AI_TOP_K=5
AI_MIN_SCORE=0.18
AI_MAX_OUTPUT_TOKENS=600
AI_CHAT_TIMEOUT_SECONDS=60
# Dashscope Qwen thinking models may require this for buffered non-streaming Chat.
# Leave false for providers that do not accept enable_thinking.
AI_DISABLE_THINKING=false

# Optional Go public note search; export explicitly, Go does not load this file.
ES_URL=
ES_INDEX=community-notes-v1
ES_TIMEOUT_SECONDS=3
GO_ES_PORT=9202
# Kafka community outbox relay concurrency (1..8; default 1).
GO_COMMUNITY_RELAY_WORKERS=1
# Kafka consumer synchronous offset batch for durable LIKE receipts (1..64; default 1).
GO_COMMUNITY_CONSUMER_COMMIT_BATCH=1
