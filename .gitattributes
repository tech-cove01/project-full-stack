* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Capacity captures are byte evidence; newline conversion would invalidate SHA256.
docs/evidence/2026-10-30-go073-cap/**/*.json -text
docs/evidence/2026-10-30-go073-cap/**/*.ndjson -text
docs/evidence/2026-10-30-go073-cap/**/*.txt -text
docs/evidence/2026-10-30-go073-cap/**/*.log -text
docs/evidence/2026-10-30-go073-cap/**/*.gz binary
docs/evidence/2026-10-30-go073-cap/**/*.pprof binary

# CAP-06/07 captures retain their original bytes for cross-file hash audits.
docs/evidence/2026-10-30-cap06/**/*.json -text
docs/evidence/2026-10-30-cap06/**/*.ndjson -text
docs/evidence/2026-10-30-cap06/**/*.txt -text
